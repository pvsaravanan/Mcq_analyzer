{
  "manifest_version": 3,
  "name": "LMS MCQ Helper",
  "version": "2.0.0",
  "description": "Detects Multiple Choice Questions on LMS pages and provides AI-powered answers and explanations in a draggable box.",
  "permissions": [
    "activeTab",
    "scripting"
   ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LMS MCQ Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://lms2.cse.saveetha.in/*",
        "https://lms2.cse.saveetha.in/*",
        "http://lms2.ai.saveetha.in/*",
        "https://lms2.ai.saveetha.in/*",
        "http://lms.saveetha.in/*",
        "https://lms.saveetha.in/*",
        "http://training.saveetha.in/*",
        "https://training.saveetha.in/*",
        "http://training2.saveetha.in/*",
        "https://training2.saveetha.in/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}